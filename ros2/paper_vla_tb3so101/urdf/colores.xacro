<?xml version="1.0"?>
<!-- Paleta propia del robot (sustituye a materials.xacro de ROBOTIS, que es todo gris).
     Los nombres coinciden con los que usan las macros de ROBOTIS: grey = eslabones del brazo, light_black = placa base del Waffle Pi,
     dark = ruedas y lidar, red = marcador del efector final. -->
<robot>
  <material name="grey"><color rgba="1.0 0.45 0.0 1.0"/></material>
  <material name="light_black"><color rgba="0.05 0.35 0.75 1.0"/></material>
  <material name="dark"><color rgba="0.08 0.08 0.10 1.0"/></material>
  <material name="red"><color rgba="1.0 0.1 0.1 1.0"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="brown"><color rgba="0.87 0.81 0.76 1"/></material>
  <material name="green"><color rgba="0 0.8 0 1"/></material>
  <material name="orange"><color rgba="1.0 0.42 0.04 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="cam_wrist"><color rgba="0.0 0.9 0.9 1.0"/></material>
  <material name="cam_front"><color rgba="0.9 0.1 0.9 1.0"/></material>
</robot>
